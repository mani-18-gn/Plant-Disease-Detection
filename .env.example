# Environment Configuration for ArecaAgent
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git — it is excluded by .gitignore.

# Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-super-secret-jwt-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Single source of truth for the database connection.
# For Neon (hosted PostgreSQL), use the connection string from your Neon dashboard.
# sslmode=require is mandatory for Neon — do not remove it.
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# The POSTGRES_* fields below are only used for local Docker Compose dev.
# They are NOT read by session.py — DATABASE_URL above is what the app uses.
POSTGRES_USER=areca_user
POSTGRES_PASSWORD=areca_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=areca_agent_db

# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DAILY_BUDGET_CAP=100

# ── Weather API (Open-Meteo requires no API key) ──────────────────────────────
# WEATHER_API_KEY is not needed for Open-Meteo.
WEATHER_API_KEY=

# ── Data.gov.in Mandi Market Price API ───────────────────────────────────────
DATA_GOV_IN_API_KEY=your-datagov-api-key

# ── MQTT Broker (for ESP32 IoT sensors) ──────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

